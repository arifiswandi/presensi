const SPREADSHEET_ID = '1SQ4MpkOUMfVd9QsNW51ubqafOIvtUnYOIOxhn54YiLU';
// const SPREADSHEET_ID = 'ID_SPREADSHEET_ANDA';

const DEFAULT_USER = {
  username: 'admin',
  password: 'admin123',
  role: 'superuser'
};

function doPost(e) {
  const output = ContentService.createTextOutput();
  output.setMimeType(ContentService.MimeType.JSON);

  const lock = LockService.getScriptLock();
  lock.tryLock(10000);

  try {
    let raw = '';
    if (e && e.postData && e.postData.contents) {
      raw = e.postData.contents;
    }

    if (!raw) {
      throw new Error('Payload kosong atau tidak valid.');
    }

    let data = {};
    try {
      data = JSON.parse(raw);
    } catch (jsonErr) {
      const params = new URLSearchParams(raw);
      data = Object.fromEntries(params.entries());
    }

    const action = data.action;
    let result;

    switch (action) {
      case 'login':
        result = loginUser(data.username, data.password);
        break;
      case 'read':
        result = getAnekdot();
        break;
      case 'create':
        result = createAnekdot(data.payload || data);
        break;
      case 'update':
        result = updateAnekdot(data.payload || data);
        break;
      case 'delete':
        result = deleteAnekdot(data.id);
        break;
      default:
        result = { success: false, message: 'Aksi tidak dikenali' };
    }

    return output.setContent(JSON.stringify(result));
  } catch (error) {
    return output.setContent(JSON.stringify({
      success: false,
      message: String(error && error.message ? error.message : error)
    }));
  } finally {
    if (lock.hasLock()) {
      lock.releaseLock();
    }
  }
}

function doGet(e) {
  return ContentService
    .createTextOutput(JSON.stringify({
      success: true,
      message: 'Backend Aplikasi BK Aktif'
    }))
    .setMimeType(ContentService.MimeType.JSON);
}

// --- FUNGSI LOGIN ---
function getOrCreateSheet(sheetName) {
  const ss = SpreadsheetApp.openById(SPREADSHEET_ID);
  let sheet = ss.getSheetByName(sheetName);

  if (!sheet) {
    sheet = ss.insertSheet(sheetName);
  }

  return sheet;
}

function ensureDefaultUser() {
  const usersSheet = getOrCreateSheet('Users');
  const values = usersSheet.getDataRange().getValues();

  if (values.length <= 1) {
    usersSheet.appendRow([DEFAULT_USER.username, DEFAULT_USER.password, DEFAULT_USER.role]);
    return;
  }

  for (let i = 1; i < values.length; i++) {
    const rowUsername = String(values[i][0] || '').trim();
    const rowPassword = String(values[i][1] || '').trim();
    const rowRole = String(values[i][2] || '').trim();

    if (rowUsername === DEFAULT_USER.username && rowPassword === DEFAULT_USER.password) {
      return;
    }
  }

  usersSheet.appendRow([DEFAULT_USER.username, DEFAULT_USER.password, DEFAULT_USER.role]);
}

function loginUser(username, password) {
  ensureDefaultUser();

  const sheet = getOrCreateSheet('Users');
  const data = sheet.getDataRange().getValues();

  const cleanUsername = String(username || '').trim();
  const cleanPassword = String(password || '').trim();

  for (let i = 1; i < data.length; i++) {
    const rowUsername = String(data[i][0] || '').trim();
    const rowPassword = String(data[i][1] || '').trim();
    const rowRole = String(data[i][2] || 'user').trim();

    if (rowUsername === cleanUsername && rowPassword === cleanPassword) {
      return { success: true, role: rowRole || 'user', username: cleanUsername };
    }
  }

  return { success: false, message: "Username atau Password salah" };
}

// --- FUNGSI CRUD ANEKDOT ---
function getAnekdot() {
  const sheet = SpreadsheetApp.openById(SPREADSHEET_ID).getSheetByName('Anekdot');
  const data = sheet.getDataRange().getValues();
  
  if (data.length <= 1) {
    return { success: true, data: [] };
  }

  const headers = data[0];
  const result = [];
  
  for (let i = 1; i < data.length; i++) {
    let obj = {};
    for (let j = 0; j < headers.length; j++) {
      obj[headers[j]] = data[i][j];
    }
    result.push(obj);
  }
  return { success: true, data: result };
}

function createAnekdot(payload) {
  const sheet = SpreadsheetApp.openById(SPREADSHEET_ID).getSheetByName('Anekdot');
  // const id = new Date().getTime().toString();
  const id = Utilities.getUuid();

  sheet.appendRow([
    id, 
    payload.Tanggal || '', 
    payload.NamaSiswa || '', 
    payload.Kelas || '', 
    payload.Kejadian || '', 
    payload.Penanganan || '', 
    payload.Keterangan || ''
  ]);
  
  return { success: true, message: "Catatan berhasil ditambahkan", id: id };
}

function updateAnekdot(payload) {
  const sheet = SpreadsheetApp.openById(SPREADSHEET_ID).getSheetByName('Anekdot');
  const lastRow = sheet.getLastRow();
  
  // Jika sheet kosong (hanya header atau tidak ada data sama sekali)
  if (lastRow <= 1) return { success: false, message: "Data kosong" };

  // OPTIMASI: Hanya mengambil data di Kolom 1 (Kolom A / ID) untuk mempercepat proses baca
  const ids = sheet.getRange(1, 1, lastRow, 1).getValues().map(row => String(row[0]));
  
  // Mencari index array dari ID yang dikirim
  const rowIndex = ids.indexOf(String(payload.ID));
  
  // Jika rowIndex > 0 (Ditemukan dan bukan di baris ke-0/header)
  if (rowIndex > 0) {
    const rowToUpdate = rowIndex + 1; // Ditambah 1 karena baris di Google Sheets dimulai dari 1
    
    // Hanya memperbarui sel yang berubah (Kolom B sampai G)
    sheet.getRange(rowToUpdate, 2, 1, 6).setValues([[
      payload.Tanggal || '', 
      payload.NamaSiswa || '', 
      payload.Kelas || '', 
      payload.Kejadian || '', 
      payload.Penanganan || '', 
      payload.Keterangan || ''
    ]]);
    return { success: true, message: "Catatan berhasil diubah" };
  }
  
  return { success: false, message: "ID tidak ditemukan" };
}

function deleteAnekdot(id) {
  const sheet = SpreadsheetApp.openById(SPREADSHEET_ID).getSheetByName('Anekdot');
  const lastRow = sheet.getLastRow();
  
  if (lastRow <= 1) return { success: false, message: "Data kosong" };

  // OPTIMASI: Sama seperti update, hanya membaca Kolom A
  const ids = sheet.getRange(1, 1, lastRow, 1).getValues().map(row => String(row[0]));
  const rowIndex = ids.indexOf(String(id));
  
  if (rowIndex > 0) {
    const rowToDelete = rowIndex + 1;
    sheet.deleteRow(rowToDelete);
    return { success: true, message: "Catatan berhasil dihapus" };
  }
  
  return { success: false, message: "ID tidak ditemukan" };
}