const PRESENSI_FOLDER_ID = '1kS9hXo_Eoeb4HgAoH8wtOSGSsKCl9udS';
const PRESENSI_FILE_PREFIX = 'Presensi_';
const SISWA_FILE_PREFIX = 'Siswa_';

function coerceDateValue(dateValue) {
  if (dateValue instanceof Date) {
    return Number.isNaN(dateValue.getTime()) ? new Date() : dateValue;
  }

  if (dateValue && typeof dateValue === 'object') {
    const directDate = dateValue.tanggal || dateValue.date || dateValue.Date || dateValue.value;
    if (directDate) {
      const parsedDirect = new Date(directDate);
      if (!Number.isNaN(parsedDirect.getTime())) {
        return parsedDirect;
      }
    }

    const candidateYear = Number(dateValue.year ?? dateValue.Year ?? dateValue.y ?? dateValue.tahun ?? dateValue.Tahun ?? 0);
    const candidateMonth = Number(dateValue.month ?? dateValue.Month ?? dateValue.m ?? dateValue.bulan ?? dateValue.Bulan ?? 0);

    if (Number.isFinite(candidateYear) && candidateYear > 0 && Number.isFinite(candidateMonth) && candidateMonth >= 1 && candidateMonth <= 12) {
      return new Date(candidateYear, candidateMonth - 1, 1);
    }
  }

  if (typeof dateValue === 'number' && Number.isFinite(dateValue)) {
    if (dateValue >= 1 && dateValue <= 12) {
      return new Date(new Date().getFullYear(), dateValue - 1, 1);
    }
    return new Date(dateValue);
  }

  if (typeof dateValue === 'string') {
    const text = normalizeText(dateValue);
    if (!text) {
      return new Date();
    }

    const yearMonthMatch = text.match(/^(\d{4})[-/](\d{1,2})$/);
    if (yearMonthMatch) {
      const year = Number(yearMonthMatch[1]);
      const month = Number(yearMonthMatch[2]);
      if (Number.isFinite(year) && year > 0 && Number.isFinite(month) && month >= 1 && month <= 12) {
        return new Date(year, month - 1, 1);
      }
    }

    const numericMonth = Number(text);
    if (!Number.isNaN(numericMonth) && numericMonth >= 1 && numericMonth <= 12) {
      return new Date(new Date().getFullYear(), numericMonth - 1, 1);
    }

    const parsed = new Date(text);
    return Number.isNaN(parsed.getTime()) ? new Date() : parsed;
  }

  return new Date(dateValue || Date.now());
}

function getAcademicYear(dateValue) {
  const sourceDate = coerceDateValue(dateValue);

  if (Number.isNaN(sourceDate.getTime())) {
    return Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'yyyy');
  }

  const year = sourceDate.getFullYear();
  const month = sourceDate.getMonth() + 1;
  const startYear = month >= 7 ? year : year - 1;
  const endYear = startYear + 1;

  return `${startYear}-${endYear}`;
}

function getAcademicSemester(dateValue) {
  return 'Ganjil';
}

function normalizeClassKey(value) {
  const raw = normalizeText(value).replace(/\s+/g, ' ');
  if (!raw) {
    return 'UMUM';
  }

  return raw
    .toUpperCase()
    .replace(/[^A-Z0-9]/g, '_')
    .replace(/_+/g, '_')
    .replace(/^_+|_+$/g, '') || 'UMUM';
}

function getOrCreateFolderByName(folderName, parentFolder) {
  const rootFolder = parentFolder || DriveApp.getRootFolder();
  const folders = rootFolder.getFoldersByName(folderName);

  if (folders.hasNext()) {
    return folders.next();
  }

  return rootFolder.createFolder(folderName);
}

function getPresensiRootFolder() {
  if (PRESENSI_FOLDER_ID) {
    try {
      return DriveApp.getFolderById(PRESENSI_FOLDER_ID);
    } catch (error) {
      return DriveApp.getRootFolder();
    }
  }

  return DriveApp.getRootFolder();
}

function getAcademicYearFolder(dateValue) {
  const yearFolderName = getAcademicYear(dateValue);
  const rootFolder = getPresensiRootFolder();

  return getOrCreateFolderByName(yearFolderName, rootFolder);
}

function getPrimarySpreadsheetFileByName(folder, spreadsheetName) {
  const allFiles = [];
  const iterator = folder.getFilesByName(spreadsheetName);

  while (iterator.hasNext()) {
    allFiles.push(iterator.next());
  }

  if (!allFiles.length) {
    return null;
  }

  if (allFiles.length > 1) {
    allFiles.slice(1).forEach((file) => {
      try {
        file.setTrashed(true);
      } catch (error) {
        // ignore duplicate cleanup errors
      }
    });
  }

  return allFiles[0];
}

function ensureSiswaSpreadsheetReady(dateValue) {
  const seedDate = dateValue || new Date();
  return getOrCreateSiswaSpreadsheet(seedDate);
}

function getOrCreateSiswaSpreadsheet(dateValue) {
  const academicYear = getAcademicYear(dateValue);
  const spreadsheetName = `${SISWA_FILE_PREFIX}${academicYear}`;
  const targetFolder = getAcademicYearFolder(dateValue);

  const lock = LockService.getScriptLock();
  lock.waitLock(15000);

  try {
    const existingFile = getPrimarySpreadsheetFileByName(targetFolder, spreadsheetName);
    if (existingFile) {
      const ss = SpreadsheetApp.openById(existingFile.getId());
      const sheet = getOrCreateSheet(ss, 'Siswa');
      ensureHeaderRow(sheet, ['ID', 'KELAS', 'NIS', 'NAMA', 'L/P']);
      return ss;
    }

    const newSpreadsheet = SpreadsheetApp.create(spreadsheetName);
    const createdFile = DriveApp.getFileById(newSpreadsheet.getId());

    if (createdFile.getParents().next().getId() !== targetFolder.getId()) {
      createdFile.moveTo(targetFolder);
    }

    const ss = SpreadsheetApp.openById(createdFile.getId());
    const sheet = getOrCreateSheet(ss, 'Siswa');
    ensureHeaderRow(sheet, ['ID', 'KELAS', 'NIS', 'NAMA', 'L/P']);
    return ss;
  } finally {
    lock.releaseLock();
  }
}

function getOrCreateClassSpreadsheet(kelas, dateValue) {
  const normalizedKelas = normalizeText(kelas);
  if (!normalizedKelas) {
    throw new Error('Kelas wajib diisi untuk membuat atau membuka spreadsheet presensi.');
  }

  const classKey = normalizeClassKey(normalizedKelas);
  const academicYear = getAcademicYear(dateValue);
  const semester = getAcademicSemester(dateValue);
  const spreadsheetName = `${PRESENSI_FILE_PREFIX}${classKey}_${academicYear}_${semester}`;
  const targetFolder = getAcademicYearFolder(dateValue);

  const lock = LockService.getScriptLock();
  lock.waitLock(15000);

  try {
    const existingFile = getPrimarySpreadsheetFileByName(targetFolder, spreadsheetName);
    if (existingFile) {
      const ss = SpreadsheetApp.openById(existingFile.getId());
      const sheet = getOrCreateSheet(ss, 'Presensi');
      ensureHeaderRow(sheet, ['timestamp', 'tanggal', 'kelas', 'nis', 'nama', 'status']);
      return ss;
    }

    const newSpreadsheet = SpreadsheetApp.create(spreadsheetName);
    const createdFile = DriveApp.getFileById(newSpreadsheet.getId());

    if (createdFile.getParents().next().getId() !== targetFolder.getId()) {
      createdFile.moveTo(targetFolder);
    }

    const ss = SpreadsheetApp.openById(createdFile.getId());
    const sheet = getOrCreateSheet(ss, 'Presensi');
    ensureHeaderRow(sheet, ['timestamp', 'tanggal', 'kelas', 'nis', 'nama', 'status']);
    return ss;
  } finally {
    lock.releaseLock();
  }
}

function getSpreadsheet(spreadsheetTarget, dateValue) {
  const normalizedTarget = (spreadsheetTarget == null ? '' : String(spreadsheetTarget).trim());

  if (!normalizedTarget || normalizedTarget === 'default' || normalizedTarget === 'monthly' || normalizedTarget === 'presensi' || normalizedTarget === 'rekap') {
    throw new Error('Route spreadsheet lama tidak diizinkan. Gunakan format Siswa_YYYY-YYYY atau Presensi_<KELAS>_YYYY-YYYY_Ganjil.');
  }

  if (normalizedTarget === 'siswa') {
    return getOrCreateSiswaSpreadsheet(dateValue || new Date());
  }

  if (normalizedTarget === 'kelas' || normalizedTarget === 'class' || normalizedTarget === 'classroom') {
    const kelas = dateValue && (dateValue.kelas || dateValue.className || dateValue.class)
      ? (dateValue.kelas || dateValue.className || dateValue.class)
      : '';
    return getOrCreateClassSpreadsheet(kelas, dateValue || new Date());
  }

  if (/^\d{4}-\d{2}$/.test(normalizedTarget)) {
    throw new Error('Format spreadsheet bulanan dinonaktifkan. Gunakan Presensi_<KELAS>_YYYY-YYYY_Ganjil.');
  }

  if (normalizedTarget.length >= 20) {
    try {
      return SpreadsheetApp.openById(normalizedTarget);
    } catch (error) {
      throw new Error('ID spreadsheet tidak valid atau tidak ditemukan.');
    }
  }

  throw new Error('Target spreadsheet tidak valid. Gunakan format Siswa_YYYY-YYYY atau Presensi_<KELAS>_YYYY-YYYY_Ganjil.');
}

function getRequestSpreadsheetTarget(data, fallback) {
  if (!data || typeof data !== 'object') {
    return fallback || '';
  }

  const rawTarget =
    data.spreadsheetId ||
    data.spreadsheet ||
    data.spreadsheetKey ||
    data.spreadsheet_name ||
    data.spreadsheetTarget ||
    data.target ||
    '';

  const normalizedRawTarget = normalizeText(rawTarget).toLowerCase();
  const isLegacyTarget = ['default', 'monthly', 'presensi', 'rekap', 'bulan', 'classroom', 'kelas', 'class'].includes(normalizedRawTarget);

  if (isLegacyTarget && ['kelas', 'class', 'classroom'].includes(normalizedRawTarget)) {
    return normalizedRawTarget;
  }

  if (isLegacyTarget && normalizedRawTarget === 'siswa') {
    return 'siswa';
  }

  return rawTarget || fallback || '';
}

function resolveTargetSpreadsheet(data, action) {
  const dateForSpreadsheet = data && (data.tanggal || data.date || data.bulan || data.year || data.tahun)
    ? data
    : new Date();

  if (['getSiswa', 'createSiswaSpreadsheet', 'importSiswa'].includes(action)) {
    return getOrCreateSiswaSpreadsheet(dateForSpreadsheet);
  }

  const target = getRequestSpreadsheetTarget(data, '');

  if (target === 'kelas' || target === 'class' || target === 'classroom') {
    const kelas = data && (data.kelas || data.className || data.class || '');
    return getOrCreateClassSpreadsheet(kelas, dateForSpreadsheet);
  }

  if (data && typeof data === 'object' && (data.kelas || data.className || data.class)) {
    const kelas = data.kelas || data.className || data.class;
    const classTargetActions = ['simpanPresensi', 'getPresensiByDate', 'getRekap', 'getPresensiByKelasBulan', 'getPresensiKelasBulan'];

    if (classTargetActions.includes(action)) {
      return getOrCreateClassSpreadsheet(kelas, dateForSpreadsheet);
    }
  }

  if (target === 'siswa') {
    return getOrCreateSiswaSpreadsheet(dateForSpreadsheet);
  }

  if (target && target !== 'default') {
    return getSpreadsheet(target, dateForSpreadsheet);
  }

  throw new Error('Tidak ada route spreadsheet yang valid. Gunakan Siswa_YYYY-YYYY atau Presensi_<KELAS>_YYYY-YYYY_Ganjil.');
}

function responseJSON(payload) {
  return ContentService.createTextOutput(JSON.stringify(payload)).setMimeType(ContentService.MimeType.JSON);
}

function getOrCreateSheet(ss, sheetName) {
  if (sheetName === 'Sheet1') {
    return ss.getSheetByName('Sheet1') || ss.insertSheet('Sheet1');
  }

  const existingSheet = ss.getSheetByName(sheetName);
  if (existingSheet) {
    return existingSheet;
  }

  const defaultSheet = ss.getSheetByName('Sheet1');
  if (defaultSheet) {
    if (ss.getSheets().length === 1) {
      defaultSheet.setName(sheetName);
      return defaultSheet;
    }

    ss.deleteSheet(defaultSheet);
  }

  return ss.insertSheet(sheetName);
}

function ensureHeaderRow(sheet, headers) {
  const lastRow = sheet.getLastRow();
  const targetRange = sheet.getRange(1, 1, 1, headers.length);
  const firstRow = targetRange.getValues()[0] || [];

  const hasExpectedHeader = headers.some((header, index) => {
    const value = String(firstRow[index] || '').trim().toLowerCase();
    return value === String(header).trim().toLowerCase();
  });

  if (lastRow === 0) {
    targetRange.setValues([headers]);
    return;
  }

  if (!hasExpectedHeader) {
    const rowOneHasContent = firstRow.some((cell) => String(cell || '').trim() !== '');

    if (!rowOneHasContent) {
      targetRange.setValues([headers]);
      return;
    }

    sheet.insertRowBefore(1);
    sheet.getRange(1, 1, 1, headers.length).setValues([headers]);
  }
}

function normalizeText(value) {
  return String(value == null ? '' : value).trim();
}

function normalizeJenisKelamin(value) {
  const text = normalizeText(value).toLowerCase();

  if (!text) {
    return '';
  }

  if (['l', 'lk', 'laki', 'laki-laki', 'male', 'm'].includes(text)) {
    return 'L';
  }

  if (['p', 'pr', 'perempuan', 'female', 'f', 'wanita'].includes(text)) {
    return 'P';
  }

  const firstLetter = text.charAt(0);
  if (firstLetter === 'l') {
    return 'L';
  }
  if (firstLetter === 'p') {
    return 'P';
  }

  return normalizeText(value).toUpperCase();
}

function normalizeNis(value) {
  return normalizeText(value).replace(/\s+/g, '');
}

function normalizeDateValue(value) {
  if (value instanceof Date) {
    return Utilities.formatDate(value, Session.getScriptTimeZone(), 'yyyy-MM-dd');
  }

  const text = normalizeText(value);
  if (!text) {
    return '';
  }

  const parsedDate = new Date(text);
  if (!Number.isNaN(parsedDate.getTime())) {
    return Utilities.formatDate(parsedDate, Session.getScriptTimeZone(), 'yyyy-MM-dd');
  }

  return text;
}

function normalizeStatus(value) {
  const normalized = normalizeText(value).toLowerCase();
  const statusMap = {
    hadir: 'Hadir',
    izin: 'Izin',
    sakit: 'Sakit',
    alpha: 'Alpha',
  };

  return statusMap[normalized] || normalizeText(value) || 'Hadir';
}

function buildPresensiStatusCacheKey(kelas, tanggal) {
  return `presensi-status:${normalizeText(kelas).toLowerCase()}:${normalizeDateValue(tanggal)}`;
}

function buildRekapCacheKey(kelas, bulan, tahun) {
  const normalizedKelas = normalizeText(kelas).toLowerCase();
  return `presensi-rekap:${normalizedKelas}:${Number(tahun) || new Date().getFullYear()}-${String(Number(bulan) || 1).padStart(2, '0')}`;
}

function getCachedJson(cacheKey, ttlSeconds, loader) {
  if (!cacheKey) {
    return loader();
  }

  try {
    const cache = CacheService.getScriptCache();
    const cached = cache.get(cacheKey);
    if (cached) {
      try {
        return JSON.parse(cached);
      } catch (error) {
        cache.remove(cacheKey);
      }
    }
  } catch (error) {
    // ignore cache issues and proceed with direct load
  }

  const freshValue = loader();

  if (freshValue !== undefined) {
    try {
      const cache = CacheService.getScriptCache();
      cache.put(cacheKey, JSON.stringify(freshValue), ttlSeconds);
    } catch (error) {
      // ignore cache write issues
    }
  }

  return freshValue;
}

function invalidatePresensiCachesForClass(kelas, tanggal) {
  const normalizedKelas = normalizeText(kelas);
  const cache = CacheService.getScriptCache();
  const dateValue = normalizeDateValue(tanggal);

  if (normalizedKelas) {
    cache.remove(buildPresensiStatusCacheKey(normalizedKelas, dateValue));

    if (dateValue) {
      const dateObj = new Date(dateValue + 'T00:00:00');
      if (!Number.isNaN(dateObj.getTime())) {
        const bulan = dateObj.getMonth() + 1;
        const tahun = dateObj.getFullYear();
        cache.remove(buildRekapCacheKey(normalizedKelas, bulan, tahun));
      }
    }
  }
}

function buildPresensiKey(tanggal, kelas, nis) {
  return `${normalizeDateValue(tanggal)}|${normalizeText(kelas)}|${normalizeNis(nis)}`;
}

function normalizeSiswaRecord(item) {
  if (!item || typeof item !== 'object') {
    return null;
  }

  const kelas = normalizeText(
    item.kelas ?? item.KELAS ?? item.Kelas ?? item.kls ?? item.class ?? item['KELAS'] ?? ''
  );
  const nis = normalizeNis(
    item.nis ?? item.NIS ?? item.Nis ?? item.nisn ?? item['NIS'] ?? ''
  );
  const nama = normalizeText(
    item.nama ?? item.NAMA ?? item.Nama ?? item.name ?? item.NamaSiswa ?? item['NAMA'] ?? ''
  );
  const jenisKelaminValue = (
    item.jenisKelamin ??
    item.JenisKelamin ??
    item.JENISKELAMIN ??
    item.gender ??
    item.Gender ??
    item.GENDER ??
    item.jk ??
    item.JK ??
    item['L/P'] ??
    item['L / P'] ??
    item['Jenis Kelamin'] ??
    item['JENIS KELAMIN'] ??
    ''
  );
  const jenisKelamin = normalizeJenisKelamin(jenisKelaminValue);

  if (!kelas && !nis && !nama) {
    return null;
  }

  return {
    id: normalizeText(item.id ?? item.ID ?? item['ID'] ?? ''),
    kelas,
    nis,
    nama,
    jenisKelamin,
  };
}

function createSiswaSpreadsheet(dateValue) {
  const spreadsheet = getOrCreateSiswaSpreadsheet(dateValue || new Date());

  return {
    success: true,
    spreadsheetId: spreadsheet.getId(),
    spreadsheetName: spreadsheet.getName(),
    message: 'Spreadsheet siswa berhasil dibuat.',
  };
}

function importSiswaData(ss, payload) {
  const rawRows = Array.isArray(payload?.siswaData)
    ? payload.siswaData
    : Array.isArray(payload?.data)
      ? payload.data
      : [];

  if (!rawRows.length) {
    return { success: false, message: 'Tidak ada data siswa yang dikirim untuk diimpor.' };
  }

  const sheet = getOrCreateSheet(ss, 'Siswa');
  ensureHeaderRow(sheet, ['ID', 'KELAS', 'NIS', 'NAMA', 'L/P']);

  const existingRows = sheet.getDataRange().getValues();
  const seenNis = new Set();

  existingRows.slice(1).forEach((row) => {
    if (!row || !row[2]) {
      return;
    }
    seenNis.add(normalizeNis(row[2]));
  });

  const newRows = rawRows
    .map((item) => normalizeSiswaRecord(item))
    .filter((item) => item && item.nis && !seenNis.has(item.nis))
    .map((item) => [
      item.id || '',
      item.kelas,
      item.nis,
      item.nama,
      item.jenisKelamin,
    ]);

  if (!newRows.length) {
    return { success: true, imported: 0, message: 'Tidak ada data siswa baru yang perlu ditambahkan.' };
  }

  const startRow = sheet.getLastRow() + 1;
  sheet.getRange(startRow, 1, newRows.length, 5).setValues(newRows);

  return {
    success: true,
    imported: newRows.length,
    message: `Berhasil menambahkan ${newRows.length} data siswa baru.`,
  };
}

function getSiswaData(ss) {
  const sheet = getOrCreateSheet(ss, 'Siswa');
  ensureHeaderRow(sheet, ['ID', 'KELAS', 'NIS', 'NAMA', 'L/P']);

  const rows = sheet.getDataRange().getValues();
  if (rows.length <= 1) {
    return [];
  }

  return rows.slice(1)
    .filter((row) => row.some((cell) => cell !== ''))
    .map((row) => {
      const jenisKelamin = normalizeJenisKelamin(row[4]);

      return {
        id: row[0] ?? '',
        kelas: row[1] ?? '',
        nis: row[2] ?? '',
        nama: row[3] ?? '',
        jenisKelamin,
        gender: jenisKelamin,
      };
    });
}

function simpanPresensi(ss, payload) {
  if (!payload || !payload.tanggal || !payload.kelas) {
    return { success: false, message: 'Tanggal dan kelas wajib diisi.' };
  }

  const sheet = getOrCreateSheet(ss, 'Presensi');
  ensureHeaderRow(sheet, ['timestamp', 'tanggal', 'kelas', 'nis', 'nama', 'status']);

  const attendanceList = Array.isArray(payload.presensiData) ? payload.presensiData : [];

  if (!attendanceList.length) {
    return { success: false, message: 'Tidak ada data presensi yang dikirim.' };
  }

  const lock = LockService.getScriptLock();
  lock.waitLock(15000);

  try {
    const savedAt = new Date();
    const formattedTimestamp = Utilities.formatDate(savedAt, Session.getScriptTimeZone(), 'yyyy-MM-dd HH:mm:ss');
    const normalizedTanggal = normalizeDateValue(payload.tanggal);
    const normalizedKelas = normalizeText(payload.kelas);
    const seen = new Set();
    const existingRowIndexByKey = new Map();
    let savedCount = 0;

    const rows = sheet.getDataRange().getValues();

    rows.slice(1).forEach((row, index) => {
      if (!row || row.length < 6) {
        return;
      }

      const rowDate = normalizeDateValue(row[1]);
      const rowKelas = normalizeText(row[2]);
      const rowNis = normalizeNis(row[3]);

      if (!rowDate || !rowKelas || !rowNis) {
        return;
      }

      existingRowIndexByKey.set(buildPresensiKey(rowDate, rowKelas, rowNis), index + 2);
    });

    const batchRows = [];

    attendanceList.forEach((item) => {
      if (!item || !item.nis) {
        return;
      }

      const nis = normalizeNis(item.nis);
      const nama = normalizeText(item.nama);
      const status = normalizeStatus(item.status || 'Hadir');
      const key = buildPresensiKey(normalizedTanggal, normalizedKelas, nis);

      if (seen.has(key)) {
        return;
      }
      seen.add(key);

      const rowData = [
        formattedTimestamp,
        normalizedTanggal,
        normalizedKelas,
        nis,
        nama,
        status,
      ];

      const existingRowIndex = existingRowIndexByKey.get(key) || 0;

      if (existingRowIndex > 0) {
        sheet.getRange(existingRowIndex, 1, 1, rowData.length).setValues([rowData]);
      } else {
        batchRows.push(rowData);
      }

      savedCount += 1;
    });

    if (batchRows.length) {
      if (sheet.getLastRow() === 0) {
        sheet.getRange(1, 1, 1, 6).setValues([['timestamp', 'tanggal', 'kelas', 'nis', 'nama', 'status']]);
      }
      sheet.getRange(sheet.getLastRow() + 1, 1, batchRows.length, 6).setValues(batchRows);
    }

    invalidatePresensiCachesForClass(normalizedKelas, normalizedTanggal);

    return {
      success: true,
      message: `Data presensi berhasil disimpan (${savedCount} siswa).`,
      savedCount,
    };
  } finally {
    lock.releaseLock();
  }
}

function getPresensiByDate(ss, params) {
  const tanggal = normalizeDateValue(params && params.tanggal ? params.tanggal : '');
  const kelas = normalizeText(params && params.kelas ? params.kelas : '');

  if (!tanggal || !kelas) {
    return { success: false, message: 'Tanggal dan kelas wajib diisi.' };
  }

  const cacheKey = buildPresensiStatusCacheKey(kelas, tanggal);

  return getCachedJson(cacheKey, 300, () => {
    const sheet = getOrCreateSheet(ss, 'Presensi');
    const rows = sheet.getDataRange().getValues();

    if (rows.length <= 1) {
      return { success: true, data: {} };
    }

    const statusByNis = {};

    rows.slice(1).forEach((row) => {
      if (!row || row.length < 6) {
        return;
      }

      const rowDate = normalizeDateValue(row[1]);
      const rowKelas = normalizeText(row[2]);
      const rowNis = normalizeNis(row[3]);
      const status = normalizeStatus(row[5]);

      if (!rowDate || !rowKelas || !rowNis) {
        return;
      }

      if (rowDate === tanggal && rowKelas === kelas) {
        statusByNis[rowNis] = status;
      }
    });

    return { success: true, data: statusByNis };
  });
}

function cleanupDuplicatePresensi(ss) {
  const sheet = getOrCreateSheet(ss, 'Presensi');
  const values = sheet.getDataRange().getValues();

  if (values.length <= 1) {
    return { success: true, removed: 0, message: 'Tidak ada data presensi untuk dibersihkan.' };
  }

  const lastRowByKey = new Map();
  const rowsToDelete = new Set();

  values.slice(1).forEach((row, index) => {
    if (!row || row.every((cell) => String(cell || '').trim() === '')) {
      return;
    }

    if (row.length < 6) {
      return;
    }

    const tanggal = normalizeDateValue(row[1]);
    const kelas = normalizeText(row[2]);
    const nis = normalizeNis(row[3]);

    if (!tanggal || !kelas || !nis) {
      return;
    }

    const key = buildPresensiKey(tanggal, kelas, nis);
    const absoluteRow = index + 2;

    if (lastRowByKey.has(key)) {
      rowsToDelete.add(lastRowByKey.get(key));
    }

    lastRowByKey.set(key, absoluteRow);
  });

  const finalRowsToDelete = [...rowsToDelete]
    .filter((rowNumber) => rowNumber > 1)
    .sort((a, b) => b - a);

  if (!finalRowsToDelete.length) {
    return { success: true, removed: 0, message: 'Tidak ditemukan duplikasi pada tanggal + kelas + NIS.' };
  }

  finalRowsToDelete.forEach((rowNumber) => {
    sheet.deleteRow(rowNumber);
  });

  return {
    success: true,
    removed: finalRowsToDelete.length,
    message: `Berhasil membersihkan ${finalRowsToDelete.length} data duplikat pada sheet Presensi.`,
  };
}

function getRekapData(ss, params) {
  const kelas = params && params.kelas ? String(params.kelas) : '';
  const bulan = Number(params && params.bulan ? params.bulan : 0);
  const tahun = Number(params && params.tahun ? params.tahun : 0);

  if (!kelas || !bulan || !tahun) {
    return { success: false, message: 'Parameter kelas, bulan, dan tahun wajib diisi.' };
  }

  const cacheKey = buildRekapCacheKey(kelas, bulan, tahun);

  return getCachedJson(cacheKey, 600, () => {
    cleanupDuplicatePresensi(ss);

    const siswaSpreadsheet = getOrCreateSiswaSpreadsheet({
      year: tahun,
      month: bulan,
    });
    const sheetSiswa = getOrCreateSheet(siswaSpreadsheet, 'Siswa');
    const dataSiswa = sheetSiswa.getDataRange().getValues();
    if (dataSiswa.length <= 1) {
      return { success: true, data: [] };
    }

    const siswaKelas = dataSiswa.slice(1)
      .filter((row) => normalizeText(row[1]) === normalizeText(kelas))
      .map((row) => ({
        nis: normalizeNis(row[2]),
        nama: normalizeText(row[3]),
      }))
      .filter((row) => row.nis);

    const sheetPresensi = getOrCreateSheet(ss, 'Presensi');
    const dataPresensi = sheetPresensi.getDataRange().getValues();

    if (dataPresensi.length <= 1) {
      return { success: true, data: siswaKelas.map((siswa) => ({
        nis: siswa.nis,
        nama: siswa.nama,
        Hadir: 0,
        Izin: 0,
        Sakit: 0,
        Alpha: 0,
        Total: 0,
      })) };
    }

    const rekapMap = {};
    siswaKelas.forEach((siswa) => {
      rekapMap[siswa.nis] = {
        nis: siswa.nis,
        nama: siswa.nama,
        Hadir: 0,
        Izin: 0,
        Sakit: 0,
        Alpha: 0,
        Total: 0,
      };
    });

    const uniqueKeys = new Set();

    dataPresensi.slice(1).forEach((row) => {
      if (!row || row.length < 6) {
        return;
      }

      const tanggal = normalizeDateValue(row[1]);
      const kelasPresensi = normalizeText(row[2]);
      const nis = normalizeNis(row[3]);
      const status = normalizeStatus(row[5]);

      if (!tanggal || !kelasPresensi || !nis || !status) {
        return;
      }

      const dateValue = new Date(tanggal + 'T00:00:00');
      if (Number.isNaN(dateValue.getTime())) {
        return;
      }

      if (kelasPresensi !== normalizeText(kelas)) {
        return;
      }

      if (dateValue.getMonth() + 1 !== bulan || dateValue.getFullYear() !== tahun) {
        return;
      }

      if (!rekapMap[nis]) {
        return;
      }

      const key = buildPresensiKey(tanggal, kelasPresensi, nis);
      if (uniqueKeys.has(key)) {
        return;
      }
      uniqueKeys.add(key);

      if (rekapMap[nis][status] !== undefined) {
        rekapMap[nis][status] += 1;
        rekapMap[nis].Total += 1;
      }
    });

    return { success: true, data: Object.values(rekapMap) };
  });
}

function getPresensiByKelasBulan(ss, params) {
  const kelas = params && (params.kelas || params.className || params.class) ? String(params.kelas || params.className || params.class) : '';
  const bulan = Number(params && params.bulan ? params.bulan : 0);
  const tahun = Number(params && params.tahun ? params.tahun : 0);

  if (!kelas || !bulan || !tahun) {
    return { success: false, message: 'Parameter kelas, bulan, dan tahun wajib diisi.' };
  }

  const cacheKey = buildRekapCacheKey(kelas, bulan, tahun);

  return getCachedJson(cacheKey, 300, () => {
    const rows = ss.getDataRange().getValues();

    if (rows.length <= 1) {
      return { success: true, data: {} };
    }

    const result = {};
    rows.slice(1).forEach((row) => {
      if (!row || row.length < 6) {
        return;
      }

      const tanggal = normalizeDateValue(row[1]);
      const rowKelas = normalizeText(row[2]);
      const nis = normalizeNis(row[3]);
      const status = normalizeStatus(row[5]);

      if (!tanggal || !rowKelas || !nis) {
        return;
      }

      const dateValue = new Date(tanggal + 'T00:00:00');
      if (Number.isNaN(dateValue.getTime())) {
        return;
      }

      if (rowKelas !== normalizeText(kelas)) {
        return;
      }

      if (dateValue.getMonth() + 1 !== bulan || dateValue.getFullYear() !== tahun) {
        return;
      }

      result[tanggal] = result[tanggal] || {};
      result[tanggal][nis] = status;
    });

    return { success: true, data: result };
  });
}

function executeAction(data, action) {
  if (!action || ['getSiswa', 'createSiswaSpreadsheet', 'importSiswa'].includes(action)) {
    ensureSiswaSpreadsheetReady(data && (data.tanggal || data.date || data.bulan || data.year || data.tahun) ? data : new Date());
  }

  const ss = resolveTargetSpreadsheet(data, action);

  if (action === 'getSiswa') {
    return responseJSON({ success: true, data: getSiswaData(ss) });
  }

  if (action === 'createSiswaSpreadsheet') {
    return responseJSON(createSiswaSpreadsheet(data && (data.tanggal || data.date || data.bulan)));
  }

  if (action === 'importSiswa') {
    return responseJSON(importSiswaData(ss, data));
  }

  if (action === 'simpanPresensi') {
    return responseJSON(simpanPresensi(ss, data));
  }

  if (action === 'getRekap') {
    return responseJSON(getRekapData(ss, data));
  }

  if (action === 'getPresensiByDate') {
    return responseJSON(getPresensiByDate(ss, data));
  }

  if (action === 'getPresensiByKelasBulan' || action === 'getPresensiKelasBulan') {
    return responseJSON(getPresensiByKelasBulan(ss, data));
  }

  if (action === 'cleanupDuplicatePresensi') {
    return responseJSON(cleanupDuplicatePresensi(ss));
  }

  return responseJSON({ success: false, message: 'Aksi tidak valid.' });
}

function doGet(e) {
  try {
    const params = (e && e.parameter) ? e.parameter : {};
    return executeAction(params, params.action || '');
  } catch (error) {
    return responseJSON({
      success: false,
      message: error && error.message ? error.message : String(error),
    });
  }
}

function doPost(e) {
  try {
    const raw = (e && e.postData && e.postData.contents) ? e.postData.contents : '';
    const payload = raw ? JSON.parse(raw) : {};
    return executeAction(payload, payload.action || '');
  } catch (error) {
    return responseJSON({
      success: false,
      message: error && error.message ? error.message : String(error),
    });
  }
}